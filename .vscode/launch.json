{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run TalentLens AI (Server & UI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Run Unit Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "📈 Train ML Baseline Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/train_baseline.py",
      "console": "integratedTerminal"
    },
    {
      "name": "📊 Evaluate Ranking (IR Metrics)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/evaluate_ranking.py",
      "console": "integratedTerminal"
    }
  ]
}
