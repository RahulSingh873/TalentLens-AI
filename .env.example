# TalentLens AI Environment Configuration
# Copy this file to .env for local development

# Application Server
APP_NAME=TalentLens AI
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Embedding & NLP Model Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_LOCAL_CACHE=true
MODEL_DEVICE=cpu

# Default Scoring Weights (Configurable per Job Evaluation)
DEFAULT_WEIGHT_REQUIRED_SKILLS=0.40
DEFAULT_WEIGHT_PREFERRED_SKILLS=0.15
DEFAULT_WEIGHT_SEMANTIC_SIMILARITY=0.25
DEFAULT_WEIGHT_EXPERIENCE=0.15
DEFAULT_WEIGHT_PROJECTS=0.05

# Privacy and Storage
DATA_DIR=./data
UPLOAD_MAX_BYTES=10485760  # 10 MB limit
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]
ENABLE_EXTERNAL_APIS=false  # Privacy guarantee: local execution only
